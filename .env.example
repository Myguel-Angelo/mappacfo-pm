# Copie para .env (ignorado pelo git) e troque os valores.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-isto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Obrigatória só em produção (config.settings.prod), ex.: https://mappacfo.exemplo.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=

# Lidas pela imagem do Postgres ao criar o banco
POSTGRES_DB=mappacfo
POSTGRES_USER=mappacfo
POSTGRES_PASSWORD=troque-isto

# O host é "db" (nome do serviço no compose), não localhost
DATABASE_URL=postgres://mappacfo:troque-isto@db:5432/mappacfo
